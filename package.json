{
  "name": "web-municipalidad",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "browserslist": "> 1%",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.68.3",
    "@payloadcms/email-nodemailer": "3.68.3",
    "@payloadcms/live-preview-react": "3.68.3",
    "@payloadcms/next": "3.68.3",
    "@payloadcms/payload-cloud": "3.68.3",
    "@payloadcms/richtext-lexical": "3.68.3",
    "@payloadcms/storage-s3": "3.68.3",
    "@payloadcms/ui": "3.68.3",
    "@tabler/icons-react": "3.35.0",
    "@tailwindcss/postcss": "4.1.18",
    "cross-env": "10.1.0",
    "jspdf": "3.0.4",
    "next": "16.0.10",
    "next-themes": "0.4.6",
    "payload": "3.68.3",
    "postcss": "8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.34.5",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.18"
  },
  "devDependencies": {
    "@swc-node/register": "1.11.1",
    "@types/jsdom": "27.0.0",
    "@types/node": "25.0.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "daisyui": "5.5.13",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.10",
    "jsdom": "27.3.0",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "0.7.2",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "core-js",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
